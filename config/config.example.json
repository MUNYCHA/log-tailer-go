{
  "redis": {
    "addr": "127.0.0.1:6379",
    "password": "",
    "db": 0
  },

  "identity": {
    "serverId": "your-server-id"
  },

  "logTailer": {
    "enabled": true,
    "files": [
      { "path": "/var/log/app/app.log", "channel": "your-channel-1" },
      { "path": "/var/log/app/error.log", "channel": "your-channel-2" }
    ]
  },

  "resources": {
    "enabled": true,
    "channel": "your-resources-channel",
    "interval": "30s"
  },

  "storage": {
    "enabled": true,
    "channel": "your-storage-channel",
    "interval": "5m",
    "mounts": ["/", "/var/log"]
  },

  "docker": {
    "enabled": true,
    "channel": "your-docker-channel",
    "interval": "30s"
  },

  "database": {
    "postgres": {
      "enabled": true,
      "channel": "your-postgres-channel",
      "interval": "1m"
    }
  },

  "heartbeat": {
    "enabled": true,
    "channel": "agent-heartbeat",
    "interval": "10s"
  }
}
