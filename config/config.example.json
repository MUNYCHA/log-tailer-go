{
  "redis": {
    "addr": "127.0.0.1:6379",
    "password": "",
    "db": 0
  },

  "identity": {
    "system": {
      "id": "your-system-id",
      "name": "your-system-name"
    },
    "server": {
      "name": "your-server-name",
      "ip": "0.0.0.0"
    }
  },

  "logTailer": {
    "enabled": true,
    "files": [
      { "path": "/var/log/app/app.log", "channel": "your-channel-1" },
      { "path": "/var/log/app/error.log", "channel": "your-channel-2" }
    ]
  },

  "resources": {
    "enabled": true,
    "channel": "your-resources-channel",
    "interval": "30s"
  },

  "storage": {
    "enabled": true,
    "channel": "your-storage-channel",
    "interval": "5m",
    "mounts": ["/", "/var/log"]
  },

  "heartbeat": {
    "enabled": true,
    "channel": "agent-heartbeat",
    "interval": "10s"
  }
}
